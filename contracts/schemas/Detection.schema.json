    },
    "score": {
      "title": "Score",
      "type": "number"
    }
  },
  "required": [
    "camera_id",
    "t",
    "bbox",
    "foot_px",
    "floor_xy",
    "floor_sigma_m",
    "footprint_m",
    "kind",
    "score"

      "type": "string"
    },
    "t": {
      "title": "T",
      "type": "number"
    },
    "bbox": {
      "description": "x, y, w, h in pixels",
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Bbox",
      "type": "array"
    },
    "foot_px": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Foot Px",
      "type": "array"
    },
    "floor_xy": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Floor Xy",
      "type": "array"
    },
    "floor_sigma_m": {
      "title": "Floor Sigma M",
      "type": "number"
    },
    "footprint_m": {

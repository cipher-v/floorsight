# Fresh deployment example. Copy to terraform.tfvars (gitignored) and fill in.
region          = "us-east-1"
cool_ami_id     = "ami-REPLACE_WITH_COOL_AMI_FOR_THIS_REGION" # from the Marketplace subscription launch page
alert_email     = "you@example.com"
app_repo_url    = "https://github.com/tonystark101-debug/floorsight.git"
app_git_ref     = "REPLACE_WITH_COMMIT_SHA" # git rev-parse HEAD
app_start_command = "/opt/floorsight/py -m floorsight.server --source simlive --vision real --agent real --interlock on --sim-duration 40"
public_endpoint   = false
# When public_endpoint=true, judge_token must contain at least 20 random characters.
# judge_token = "REPLACE_WITH_RANDOM_TOKEN"
preservation_hold = true
agent_llm         = "local"

# instance_type            = "c8g.xlarge"
# bedrock_model_id         = "anthropic.claude-opus-5-5"   # or the us.* inference-profile id shown in the Bedrock console
# budget_limit_usd         = 75
# baseline_x86_count       = 0   # 1 only during the 3-way benchmark
# baseline_arm_stock_count = 0
